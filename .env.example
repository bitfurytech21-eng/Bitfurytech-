# Server runtime
PORT=3000
NODE_ENV=production
DISABLE_HMR=true

# Neon PostgreSQL
DATABASE_URL=
PG_POOL_MAX=5

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
APP_URL=
VITE_SITE_URL=

# Admin & Google OAuth (optional)
BITFURYTECH_ADMIN_EMAIL=
ADMIN_ACCESS_PASSCODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email (Resend / SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Background Schedulers & Support WebSocket Signing
PLAN_DRIVEN_ROI_ENABLED=true
DAILY_ROI_EMAILS_ENABLED=true
TWILIO_SESSION_SECRET=
