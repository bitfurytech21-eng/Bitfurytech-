# Server-only environment variables. Never prefix secrets with VITE_.
DATABASE_URL=postgresql://<application-role>:<password>@<neon-host>/<database>?sslmode=require
BETTER_AUTH_SECRET=<generate-at-least-32-random-characters>
BETTER_AUTH_URL=https://your-production-domain
BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-domain

# Zoho Mail SMTP (use an app-specific password where available)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-mailbox@your-domain
SMTP_PASS=<mailbox-or-app-password>
SMTP_FROM=BitfuryTech <your-mailbox@your-domain>

# Optional Google OAuth; leave both unset to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
