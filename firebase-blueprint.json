{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated investor profile and custody balance stored under /users/{userId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "country": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 40 },
        "walletBalance": { "type": "number" },
        "totalProfit": { "type": "number" },
        "bonus": { "type": "number" },
        "referralBonus": { "type": "number" },
        "totalDeposit": { "type": "number" },
        "preferredRail": { "type": "string", "enum": ["USDT (TRC20)", "Bitcoin (BTC)", "Ethereum (ETH)", "Bank Wire"] },
        "emailAlerts": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "role": { "type": "string", "enum": ["investor", "admin"] },
        "accountStatus": { "type": "string", "enum": ["Active", "Review", "Suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "walletBalance", "totalProfit", "bonus", "referralBonus", "totalDeposit", "role", "createdAt", "updatedAt"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "User-submitted deposit, withdrawal, or allocation ledger record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "type": { "type": "string", "enum": ["Deposit", "Withdrawal", "Investment", "Profit", "Referral"] },
        "method": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" },
        "destination": { "type": "string", "maxLength": 200 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userEmail", "type", "method", "amount", "reference", "status", "createdAt", "updatedAt"]
    },
    "InvestmentAllocation": {
      "title": "InvestmentAllocation",
      "description": "Active or completed structured portfolio mandate allocated by an investor.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "enum": ["crypto", "stock", "estate"] },
        "amount": { "type": "number" },
        "dailyRatePct": { "type": "number" },
        "durationDays": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planId", "planName", "category", "amount", "dailyRatePct", "durationDays", "status", "createdAt", "updatedAt"]
    },
    "InvestmentPlanConfig": {
      "title": "InvestmentPlanConfig",
      "description": "Administrator-managed investment mandate configuration and publication state.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "enum": ["crypto", "stock", "estate"] },
        "categoryLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 800 },
        "minDeposit": { "type": "number" },
        "maxDeposit": { "type": "number" },
        "dailyRatePct": { "type": "number" },
        "durationDays": { "type": "number" },
        "paymentFrequency": { "type": "string", "minLength": 1, "maxLength": 160 },
        "settlementRail": { "type": "string", "minLength": 1, "maxLength": 120 },
        "returnTerms": { "type": "string", "minLength": 1, "maxLength": 500 },
        "availabilityStatus": { "type": "string", "enum": ["Open", "Paused", "Closed"] },
        "published": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "categoryLabel", "audience", "description", "minDeposit", "maxDeposit", "dailyRatePct", "durationDays", "paymentFrequency", "settlementRail", "returnTerms", "availabilityStatus", "published", "image", "createdAt", "updatedAt"]
    },
    "NotificationMessage": {
      "title": "NotificationMessage",
      "description": "Account security or settlement notice addressed to a user or platform broadcast.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "enum": ["Security", "Settlement", "Yield", "Announcement"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 600 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "title", "body", "read", "createdAt"]
    },
    "PropertyOffering": {
      "title": "PropertyOffering",
      "description": "Managed real estate asset offering published by administrators.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "location": { "type": "string", "minLength": 1, "maxLength": 140 },
        "assetType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "targetYieldPct": { "type": "number" },
        "minEntry": { "type": "number" },
        "valuation": { "type": "number" },
        "occupancyPct": { "type": "number" },
        "status": { "type": "string", "enum": ["Open", "Fully Subscribed"] },
        "published": { "type": "boolean" },
        "supportingDocUrl": { "type": "string", "maxLength": 200 },
        "supportingDocName": { "type": "string", "maxLength": 140 },
        "image": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "location", "assetType", "targetYieldPct", "minEntry", "valuation", "occupancyPct", "status", "image", "summary", "createdAt", "updatedAt"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Contact desk submission stored for admin review.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "topic", "message", "createdAt"]
    },
    "CustomerDocument": {
      "title": "CustomerDocument",
      "description": "User-scoped investment agreement, receipt, deposit confirmation, or withdrawal record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "docType": { "type": "string", "enum": ["Agreement", "Receipt", "DepositConfirmation", "WithdrawalRecord", "AccountDocument"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 64 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "fileUrl": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "docType", "reference", "summary", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable record of sensitive administrative reviews and configuration updates.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "targetType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "action", "targetType", "targetId", "summary", "createdAt"]
    },
    "IdempotencyKey": {
      "title": "IdempotencyKey",
      "description": "Single-use operation key preventing duplicate financial entries.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "operation": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 64 },
        "resultId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "operation", "reference", "resultId", "createdAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Verified referral attribution linking referrerUid and referredUid.",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "code": { "type": "string", "minLength": 3, "maxLength": 40 },
        "status": { "type": "string", "enum": ["Pending", "Qualified", "Credited"] },
        "rewardAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referrerUid", "referredUid", "referredEmail", "code", "status", "rewardAmount", "createdAt", "updatedAt"]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Unique lowercase username reservation mapped to owning Firebase UID for account lookup and handle uniqueness.",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 30, "pattern": "^[a-z0-9_]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "uid", "email", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private investor profile and wallet balances scoped strictly to owner and admin."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameLookup" },
      "description": "Unique username index enforced on registration, profile updates, and username sign-in."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "Deposits, withdrawals, and mandate ledger records owned by userId."
    },
    "/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/InvestmentAllocation" },
      "description": "Structured portfolio allocations owned by userId."
    },
    "/investmentPlans/{planId}": {
      "schema": { "$ref": "#/entities/InvestmentPlanConfig" },
      "description": "Admin-managed investment plan configurations."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationMessage" },
      "description": "Per-user alerts and admin broadcasts."
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/PropertyOffering" },
      "description": "Real estate catalog managed by admin."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Write-only contact form submissions readable only by admin."
    },
    "/documents/{docId}": {
      "schema": { "$ref": "#/entities/CustomerDocument" },
      "description": "User-scoped agreements, receipts, and account documents."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative audit logs."
    },
    "/idempotencyKeys/{keyId}": {
      "schema": { "$ref": "#/entities/IdempotencyKey" },
      "description": "Replay-prevention keys for financial mutations."
    },
    "/referrals/{refId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Referral attribution records."
    }
  }
}
