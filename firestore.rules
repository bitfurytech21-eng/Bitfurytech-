rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'bitfurytech21@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'country',
          'phone',
          'walletBalance',
          'totalProfit',
          'bonus',
          'referralBonus',
          'totalDeposit',
          'preferredRail',
          'emailAlerts',
          'twoFactorEnabled',
          'role',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'country',
          'phone',
          'walletBalance',
          'totalProfit',
          'bonus',
          'referralBonus',
          'totalDeposit',
          'preferredRail',
          'emailAlerts',
          'twoFactorEnabled',
          'role',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.country is string && data.country.size() <= 80 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.walletBalance is number && data.walletBalance >= 0 &&
        data.totalProfit is number && data.totalProfit >= 0 &&
        data.bonus is number && data.bonus >= 0 &&
        data.referralBonus is number && data.referralBonus >= 0 &&
        data.totalDeposit is number && data.totalDeposit >= 0 &&
        data.preferredRail in ['USDT (TRC20)', 'Bitcoin (BTC)', 'Ethereum (ETH)', 'Bank Wire'] &&
        data.emailAlerts is bool &&
        data.twoFactorEnabled is bool &&
        data.role in ['investor', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId',
          'userEmail',
          'type',
          'method',
          'amount',
          'destination',
          'reference',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'userEmail',
          'type',
          'method',
          'amount',
          'destination',
          'reference',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        data.type in ['Deposit', 'Withdrawal', 'Investment', 'Profit', 'Referral'] &&
        data.method is string && data.method.size() >= 1 && data.method.size() <= 100 &&
        data.amount is number && data.amount > 0 &&
        data.destination is string && data.destination.size() <= 200 &&
        data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 64 &&
        data.status in ['Pending', 'Completed', 'Rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvestment(data) {
      return data.keys().hasAll([
          'userId',
          'planId',
          'planName',
          'category',
          'amount',
          'dailyRatePct',
          'durationDays',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'planId',
          'planName',
          'category',
          'amount',
          'dailyRatePct',
          'durationDays',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 64 &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 80 &&
        data.category in ['crypto', 'stock', 'estate'] &&
        data.amount is number && data.amount > 0 &&
        data.dailyRatePct is number && data.dailyRatePct > 0 &&
        data.durationDays is number && data.durationDays > 0 &&
        data.status in ['Active', 'Completed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'category', 'title', 'body', 'read', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'category', 'title', 'body', 'read', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.category in ['Security', 'Settlement', 'Yield', 'Announcement'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 600 &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidProperty(data) {
      return data.keys().hasAll([
          'title',
          'location',
          'assetType',
          'targetYieldPct',
          'minEntry',
          'valuation',
          'occupancyPct',
          'status',
          'image',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'location',
          'assetType',
          'targetYieldPct',
          'minEntry',
          'valuation',
          'occupancyPct',
          'status',
          'image',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 140 &&
        data.assetType is string && data.assetType.size() >= 1 && data.assetType.size() <= 80 &&
        data.targetYieldPct is number && data.targetYieldPct >= 0 &&
        data.minEntry is number && data.minEntry > 0 &&
        data.valuation is number && data.valuation > 0 &&
        data.occupancyPct is number && data.occupancyPct >= 0 && data.occupancyPct <= 100 &&
        data.status in ['Open', 'Fully Subscribed'] &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 200 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'topic', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().role == 'investor' &&
        incoming().walletBalance == 0 &&
        incoming().totalProfit == 0 &&
        incoming().bonus == 0 &&
        incoming().referralBonus == 0 &&
        incoming().totalDeposit == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName',
                'country',
                'phone',
                'preferredRail',
                'emailAlerts',
                'twoFactorEnabled',
                'updatedAt'
              ]) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['walletBalance', 'updatedAt']) &&
                incoming().walletBalance <= existing().walletBalance &&
                incoming().walletBalance >= 0
              )
            )
          )
        );
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(txId) &&
        isValidTransaction(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            (incoming().type in ['Deposit', 'Withdrawal'] && incoming().status == 'Pending') ||
            (incoming().type == 'Investment' && incoming().status == 'Completed')
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(txId) &&
        isValidTransaction(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        existing().status == 'Pending';
      allow delete: if false;
    }

    match /investments/{investmentId} {
      allow get: if isSignedIn() && isValidId(investmentId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(investmentId) &&
        isValidInvestment(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'Active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(investmentId) &&
        isValidInvestment(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        existing().status != 'Completed';
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || existing().userId == 'all' || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().createdAt == request.time &&
        (isAdmin() || (incoming().userId == request.auth.uid && incoming().read == false));
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
