rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'bitfurytech21@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(name) {
      return name is string && name.size() >= 3 && name.size() <= 30 && name.matches('^[a-z0-9_]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'country',
          'phone',
          'walletBalance',
          'totalProfit',
          'bonus',
          'referralBonus',
          'totalDeposit',
          'preferredRail',
          'emailAlerts',
          'twoFactorEnabled',
          'role',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'username',
          'email',
          'displayName',
          'country',
          'phone',
          'walletBalance',
          'totalProfit',
          'bonus',
          'referralBonus',
          'totalDeposit',
          'preferredRail',
          'emailAlerts',
          'twoFactorEnabled',
          'role',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        (!('username' in data) || isValidUsername(data.username)) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.country is string && data.country.size() <= 80 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.walletBalance is number && data.walletBalance >= 0 &&
        data.totalProfit is number && data.totalProfit >= 0 &&
        data.bonus is number && data.bonus >= 0 &&
        data.referralBonus is number && data.referralBonus >= 0 &&
        data.totalDeposit is number && data.totalDeposit >= 0 &&
        data.preferredRail in ['USDT (TRC20)', 'Bitcoin (BTC)', 'Ethereum (ETH)', 'Bank Wire'] &&
        data.emailAlerts is bool &&
        data.twoFactorEnabled is bool &&
        data.role in ['investor', 'admin'] &&
        (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus in ['Active', 'Review', 'Suspended'])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUsernameLookup(data, username) {
      return data.keys().hasAll(['username', 'uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['username', 'uid', 'email', 'createdAt', 'updatedAt']) &&
        isValidUsername(username) &&
        data.username == username &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'userId',
          'userEmail',
          'type',
          'method',
          'amount',
          'destination',
          'reference',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'userEmail',
          'type',
          'method',
          'amount',
          'destination',
          'reference',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200 &&
        data.type in ['Deposit', 'Withdrawal', 'Investment', 'Profit', 'Referral'] &&
        data.method is string && data.method.size() >= 1 && data.method.size() <= 100 &&
        data.amount is number && data.amount > 0 &&
        data.destination is string && data.destination.size() <= 200 &&
        data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 64 &&
        data.status in ['Pending', 'Completed', 'Rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvestment(data) {
      return data.keys().hasAll([
          'userId',
          'planId',
          'planName',
          'category',
          'amount',
          'dailyRatePct',
          'durationDays',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'planId',
          'planName',
          'category',
          'amount',
          'dailyRatePct',
          'durationDays',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 64 &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 80 &&
        data.category in ['crypto', 'stock', 'estate'] &&
        data.amount is number && data.amount > 0 &&
        data.dailyRatePct is number && data.dailyRatePct > 0 &&
        data.durationDays is number && data.durationDays > 0 &&
        data.status in ['Active', 'Completed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvestmentPlan(data) {
      return data.keys().hasAll([
          'name',
          'category',
          'categoryLabel',
          'audience',
          'description',
          'minDeposit',
          'maxDeposit',
          'dailyRatePct',
          'durationDays',
          'paymentFrequency',
          'settlementRail',
          'returnTerms',
          'availabilityStatus',
          'published',
          'image',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'category',
          'categoryLabel',
          'audience',
          'description',
          'minDeposit',
          'maxDeposit',
          'dailyRatePct',
          'durationDays',
          'paymentFrequency',
          'settlementRail',
          'returnTerms',
          'availabilityStatus',
          'published',
          'image',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.category in ['crypto', 'stock', 'estate'] &&
        data.categoryLabel is string && data.categoryLabel.size() >= 1 && data.categoryLabel.size() <= 60 &&
        data.audience is string && data.audience.size() >= 1 && data.audience.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 800 &&
        data.minDeposit is number && data.minDeposit > 0 &&
        data.maxDeposit is number && data.maxDeposit >= data.minDeposit &&
        data.dailyRatePct is number && data.dailyRatePct > 0 &&
        data.durationDays is number && data.durationDays > 0 &&
        data.paymentFrequency is string && data.paymentFrequency.size() >= 1 && data.paymentFrequency.size() <= 160 &&
        data.settlementRail is string && data.settlementRail.size() >= 1 && data.settlementRail.size() <= 120 &&
        data.returnTerms is string && data.returnTerms.size() >= 1 && data.returnTerms.size() <= 500 &&
        data.availabilityStatus in ['Open', 'Paused', 'Closed'] &&
        data.published is bool &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'category', 'title', 'body', 'read', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'category', 'title', 'body', 'read', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.category in ['Security', 'Settlement', 'Yield', 'Announcement'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 600 &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidProperty(data) {
      return data.keys().hasAll([
          'title',
          'location',
          'assetType',
          'targetYieldPct',
          'minEntry',
          'valuation',
          'occupancyPct',
          'status',
          'image',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'location',
          'assetType',
          'targetYieldPct',
          'minEntry',
          'valuation',
          'occupancyPct',
          'status',
          'published',
          'supportingDocUrl',
          'supportingDocName',
          'image',
          'summary',
          'createdAt',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 140 &&
        data.assetType is string && data.assetType.size() >= 1 && data.assetType.size() <= 80 &&
        data.targetYieldPct is number && data.targetYieldPct >= 0 &&
        data.minEntry is number && data.minEntry > 0 &&
        data.valuation is number && data.valuation > 0 &&
        data.occupancyPct is number && data.occupancyPct >= 0 && data.occupancyPct <= 100 &&
        data.status in ['Open', 'Fully Subscribed'] &&
        (!('published' in data) || data.published is bool) &&
        (!('supportingDocUrl' in data) || (data.supportingDocUrl is string && data.supportingDocUrl.size() <= 200)) &&
        (!('supportingDocName' in data) || (data.supportingDocName is string && data.supportingDocName.size() <= 140)) &&
        data.image is string && data.image.size() >= 1 && data.image.size() <= 200 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'topic', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    function isValidCustomerDocument(data) {
      return data.keys().hasAll(['userId', 'title', 'docType', 'reference', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'title', 'docType', 'reference', 'relatedId', 'summary', 'fileUrl', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.docType in ['Agreement', 'Receipt', 'DepositConfirmation', 'WithdrawalRecord', 'AccountDocument'] &&
        data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 64 &&
        (!('relatedId' in data) || (data.relatedId is string && data.relatedId.size() <= 128)) &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600 &&
        (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 200)) &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 60 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidIdempotencyKey(data) {
      return data.keys().hasAll(['userId', 'operation', 'reference', 'resultId', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'operation', 'reference', 'resultId', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.operation is string && data.operation.size() >= 1 && data.operation.size() <= 40 &&
        data.reference is string && data.reference.size() >= 1 && data.reference.size() <= 64 &&
        data.resultId is string && data.resultId.size() >= 1 && data.resultId.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['referrerUid', 'referredUid', 'referredEmail', 'code', 'status', 'rewardAmount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['referrerUid', 'referredUid', 'referredEmail', 'code', 'status', 'rewardAmount', 'createdAt', 'updatedAt']) &&
        data.referrerUid is string && data.referrerUid.size() >= 1 && data.referrerUid.size() <= 128 &&
        data.referredUid is string && data.referredUid.size() >= 1 && data.referredUid.size() <= 128 &&
        data.referredEmail is string && data.referredEmail.size() >= 3 && data.referredEmail.size() <= 200 &&
        data.code is string && data.code.size() >= 3 && data.code.size() <= 40 &&
        data.status in ['Pending', 'Qualified', 'Credited'] &&
        data.rewardAmount is number && data.rewardAmount >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().role == 'investor' &&
        incoming().walletBalance == 0 &&
        incoming().totalProfit == 0 &&
        incoming().bonus == 0 &&
        incoming().referralBonus == 0 &&
        incoming().totalDeposit == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'username',
                'displayName',
                'country',
                'phone',
                'preferredRail',
                'emailAlerts',
                'twoFactorEnabled',
                'updatedAt'
              ]) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['walletBalance', 'updatedAt']) &&
                incoming().walletBalance <= existing().walletBalance &&
                incoming().walletBalance >= 0
              )
            )
          )
        );
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if isValidUsername(username);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidUsername(username) &&
        isValidUsernameLookup(incoming(), username) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidUsername(username) &&
        isValidUsernameLookup(incoming(), username) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isSignedIn() &&
        isValidUsername(username) &&
        existing().uid == request.auth.uid;
    }

    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(txId) &&
        isValidTransaction(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            (incoming().type in ['Deposit', 'Withdrawal'] && incoming().status == 'Pending') ||
            (incoming().type == 'Investment' && incoming().status == 'Completed')
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(txId) &&
        isValidTransaction(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        existing().status == 'Pending';
      allow delete: if false;
    }

    match /investments/{investmentId} {
      allow get: if isSignedIn() && isValidId(investmentId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(investmentId) &&
        isValidInvestment(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'Active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(investmentId) &&
        isValidInvestment(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        existing().status != 'Completed';
      allow delete: if false;
    }

    match /investmentPlans/{planId} {
      allow get: if isValidId(planId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrapAdmin();
      allow create: if isAdmin() &&
        isValidId(planId) &&
        isValidInvestmentPlan(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(planId) &&
        isValidInvestmentPlan(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(planId);
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || existing().userId == 'all' || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().createdAt == request.time &&
        (isAdmin() || (incoming().userId == request.auth.uid && incoming().read == false));
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(docId) &&
        isValidCustomerDocument(incoming()) &&
        incoming().createdAt == request.time &&
        (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /manualPaymentAssignments/{assignmentId} {
      allow get, list: if isAdmin() && isValidId(assignmentId);
      allow create: if isAdmin() &&
        isValidId(assignmentId) &&
        incoming().keys().hasAll([
          'userId', 'userEmail', 'customerName', 'method', 'amount', 'destination',
          'network', 'reference', 'note', 'status', 'createdByUid', 'createdByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'userEmail', 'customerName', 'method', 'amount', 'destination',
          'network', 'reference', 'note', 'status', 'createdByUid', 'createdByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(incoming().userId) &&
        incoming().userEmail is string && incoming().userEmail.size() <= 200 &&
        incoming().customerName is string && incoming().customerName.size() > 0 && incoming().customerName.size() <= 160 &&
        incoming().method in ['USDT (TRC20)', 'Bitcoin (BTC)', 'Ethereum (ETH)', 'Bank Wire'] &&
        ((incoming().method == 'USDT (TRC20)' && incoming().network == 'TRON (TRC20)') ||
          (incoming().method == 'Bitcoin (BTC)' && incoming().network == 'Bitcoin Mainnet') ||
          (incoming().method == 'Ethereum (ETH)' && incoming().network == 'Ethereum Mainnet (ERC20)') ||
          (incoming().method == 'Bank Wire' && incoming().network == 'SWIFT / Fedwire')) &&
        incoming().amount is number && incoming().amount >= 0.01 && incoming().amount <= 10000000 &&
        incoming().destination is string && incoming().destination.size() >= 3 && incoming().destination.size() <= 220 &&
        incoming().network is string && incoming().network.size() > 0 && incoming().network.size() <= 60 &&
        incoming().reference is string && incoming().reference.size() >= 3 && incoming().reference.size() <= 120 &&
        incoming().note is string && incoming().note.size() <= 500 &&
        incoming().status == 'Assigned' &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdByEmail is string && incoming().createdByEmail.size() <= 200 &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isBootstrapAdmin();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /idempotencyKeys/{keyId} {
      allow get: if isSignedIn() && isValidId(keyId) && existing().userId == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(keyId) &&
        isValidIdempotencyKey(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /referrals/{refId} {
      allow get: if isSignedIn() && isValidId(refId) && (existing().referrerUid == request.auth.uid || existing().referredUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.referrerUid == request.auth.uid || isBootstrapAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(refId) &&
        isValidReferral(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (incoming().referredUid == request.auth.uid && incoming().status == 'Pending' && incoming().rewardAmount == 0)
        );
      allow update: if isAdmin() &&
        isValidId(refId) &&
        isValidReferral(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
